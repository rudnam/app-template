# Used by deploy/caddy.yml. DOMAIN and ACME_EMAIL come from .env.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	# "dynamic a" re-resolves the name, so `docker compose up --scale app=3`
	# spreads requests across all app containers.
	reverse_proxy {
		dynamic a app 8080
		health_uri /healthz
	}
}
