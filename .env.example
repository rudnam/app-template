# Local development: cp .env.example .env, then docker compose up -d --build.
# Never commit .env. Production doesn't use this file: its settings (the same
# variables) are in AWS Parameter Store (README.md, "Production").
COMPOSE_FILE=docker-compose.yml:deploy/local.yml

# Any value works locally.
POSTGRES_PASSWORD=local-dev-only

# Public address, used in links and redirect URIs.
DOMAIN=localhost

# Everything below is optional locally; set a feature's variables only to try it.

# Set to false to stop new accounts being created.
ALLOW_SIGNUP=true

# "Try the demo" without an account. Defaults to ALLOW_SIGNUP.
DEMO=

# Optional: "Continue with Google" on the sign-in page (README.md, "Sign in
# with Google"). The redirect URI to register is https://DOMAIN/api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: email new accounts a link to confirm their address, and offer
# "Forgot your password?". Any SMTP provider; port 587 (STARTTLS) or 465.
# Links point to https://DOMAIN.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=App Template <no-reply@example.com>
